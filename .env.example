SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional legacy aliases (supported for existing projects):
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
ADMIN_EMAILS=

# Private Cloudflare R2 media. Never put keys in browser/public variables.
R2_MEDIA_ENABLED=false
R2_BUCKET_NAME=
R2_ENDPOINT=
# Read-only credentials for the server-side playback signer:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Separate local upload credentials with Object Read & Write permission:
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
